{
  "name": "earth-agent-ai-sdk",
  "version": "1.3.2",
  "description": "Chrome extension for Earth Engine AI assistance",
  "main": "dist/background.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "version": "node scripts/version-sync.js && git add src/manifest.json mcp-server/package.json",
    "build": "webpack --config webpack.config.js",
    "watch": "webpack --config webpack.config.js --watch",
    "dev": "npm run watch",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:map-browser": "node scripts/test-map-browser.cjs",
    "test:context7": "ts-node -r tsconfig-paths/register src/examples/testContext7Tools.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "chrome-extension",
    "earth-engine",
    "ai",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
